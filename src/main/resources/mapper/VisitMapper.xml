<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.matjib.mapper.VisitMapper">

    <insert id="insert" parameterType="com.example.matjib.domain.Visit"
            useGeneratedKeys="true" keyProperty="visitId">
        INSERT INTO visit (member_id, store_id)
        VALUES (#{memberId}, #{storeId})
    </insert>

    <select id="countByMemberAndStore" resultType="int">
        SELECT COUNT(*) FROM visit
        WHERE member_id = #{memberId} AND store_id = #{storeId}
    </select>

</mapper>
